# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
env/
venv/
.venv/
ENV/

# Large Datasets & Storage (Do not commit raw MRI scans or gigabytes of images)
data/raw/*
!data/raw/.gitkeep
data/processed/*
!data/processed/.gitkeep
data/augmented/*
!data/augmented/.gitkeep

# Trained Model Weights & Checkpoints (Store weights locally or via releases/DVC)
models_checkpoints/*
!models_checkpoints/.gitkeep
*.pth
*.pt
*.onnx
*.h5
*.pkl

# Outputs & Logs
outputs/logs/*
!outputs/logs/.gitkeep
outputs/figures/*
!outputs/figures/.gitkeep
outputs/reports/*
!outputs/reports/.gitkeep
outputs/test_run/*
!outputs/test_run/.gitkeep

# Jupyter Notebooks checkpoints
.ipynb_checkpoints/
*/.ipynb_checkpoints/*

# IDEs & OS files
.vscode/
.idea/
.DS_Store
Thumbs.db
